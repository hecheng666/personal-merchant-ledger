page {
  background: #f4f6f9;
  color: #1f2733;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.page {
  padding: 24rpx 24rpx 60rpx;
}

.hero {
  padding: 12rpx 8rpx 24rpx;
}

.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  letter-spacing: -1rpx;
}

.hero-sub {
  margin-top: 10rpx;
  color: #7a8699;
  font-size: 24rpx;
  line-height: 1.6;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(16, 24, 40, 0.05);
}

.card-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.card-title .hint {
  font-size: 22rpx;
  color: #98a2b3;
  font-weight: 400;
}

.btn {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  margin: 0;
}

.btn.primary {
  background: #07c160;
  color: #ffffff;
}

.btn.ghost {
  background: #eef7f1;
  color: #07914a;
}

.btn[disabled] {
  opacity: 0.6;
}

.btn::after {
  border: none;
}

.row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #f0f2f6;
  font-size: 26rpx;
}

.row:last-child {
  border-bottom: none;
}

.row .label {
  color: #7a8699;
}

.row .value {
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.tip {
  margin-top: 18rpx;
  color: #98a2b3;
  font-size: 22rpx;
  line-height: 1.7;
}

.empty {
  padding: 80rpx 0;
  text-align: center;
  color: #98a2b3;
  font-size: 26rpx;
}
