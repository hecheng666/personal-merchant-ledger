.month-picker {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx 28rpx;
  margin-bottom: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 0 2rpx 10rpx rgba(16, 24, 40, 0.05);
}

.month-arrow {
  color: #07c160;
  font-size: 24rpx;
  font-weight: 400;
}

.kpi-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.kpi {
  width: calc(50% - 8rpx);
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 22rpx;
  padding: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(16, 24, 40, 0.05);
}

.kpi.main {
  background: linear-gradient(135deg, #0dbf6a, #07a35a);
  color: #ffffff;
}

.kpi-label {
  font-size: 22rpx;
  color: #7a8699;
}

.kpi.main .kpi-label {
  color: rgba(255, 255, 255, 0.85);
}

.kpi-value {
  margin-top: 10rpx;
  font-size: 36rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.kpi-hint {
  margin-top: 8rpx;
  font-size: 20rpx;
  color: #98a2b3;
}

.kpi.main .kpi-hint {
  color: rgba(255, 255, 255, 0.8);
}

.chart {
  display: flex;
  align-items: flex-end;
  height: 220rpx;
  gap: 4rpx;
  padding-top: 10rpx;
}

.bar-wrap {
  flex: 1;
  height: 100%;
  display: flex;
  align-items: flex-end;
}

.bar {
  width: 100%;
  background: #0dbf6a;
  border-radius: 4rpx 4rpx 0 0;
  opacity: 0.9;
}

.chart-axis {
  display: flex;
  justify-content: space-between;
  margin-top: 10rpx;
  color: #98a2b3;
  font-size: 20rpx;
}

.row .value.strong {
  color: #07914a;
}

.cash-date {
  padding: 20rpx 24rpx;
  background: #f4f6f9;
  border-radius: 16rpx;
  font-size: 26rpx;
  color: #1f2733;
}

.cash-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}

.cash-input {
  flex: 1;
  height: 76rpx;
  padding: 0 20rpx;
  background: #f4f6f9;
  border-radius: 16rpx;
  font-size: 26rpx;
}

.cash-toggle {
  display: flex;
  background: #f4f6f9;
  border-radius: 16rpx;
  padding: 6rpx;
}

.toggle {
  padding: 12rpx 22rpx;
  font-size: 24rpx;
  color: #7a8699;
  border-radius: 12rpx;
}

.toggle.on {
  background: #07c160;
  color: #ffffff;
  font-weight: 600;
}
