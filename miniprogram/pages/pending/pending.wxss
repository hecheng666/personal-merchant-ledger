.peer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #f0f2f6;
}

.peer:last-child {
  border-bottom: none;
}

.peer-main {
  flex: 1;
  min-width: 0;
}

.peer-name {
  font-size: 28rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.peer-meta {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #98a2b3;
}

.peer-amount {
  margin-left: 20rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2733;
  font-variant-numeric: tabular-nums;
  text-align: right;
  max-width: 320rpx;
}
